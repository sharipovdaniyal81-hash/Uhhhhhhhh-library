local function SwitchTab(tab)
    if switching then return end
    if currentTab == tab then return end
    switching = true

    TweenService:Create(ContentArea, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        GroupTransparency = 1
    }):Play()

    task.wait(0.18)

    for _, c in ContentArea:GetChildren() do
        if c:IsA("GuiObject") then c:Destroy() end
    end

    currentTab = tab

    for _, btnData in ipairs(tab.Buttons) do
        MakeButton(ContentArea, btnData[1], btnData[2], btnData[3])
    end

    TweenService:Create(ContentArea, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        GroupTransparency = 0
    }):Play()

    task.wait(0.22)
    switching = false
end

