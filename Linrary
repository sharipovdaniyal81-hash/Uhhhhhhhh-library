local dragref = nil
local offset  = Vector2.new(0, 0)

local function IsVisibleRecursive(obj)
    while obj do
        if obj:IsA("GuiObject") and not obj.Visible then
            return false
        end
        obj = obj.Parent
    end
    return true
end

local function IsOverButtonOrTextbox(x, y)
    for _, d in ipairs(UIMainWindow:GetDescendants()) do
        if (d:IsA("GuiButton") or d:IsA("TextBox")) and IsVisibleRecursive(d) then
            local ap, as = d.AbsolutePosition, d.AbsoluteSize
            if x >= ap.X and x <= ap.X + as.X and y >= ap.Y and y <= ap.Y + as.Y then
                return true
            end
        end
    end
    return false
end

local function StartDrag(input)
    if dragref then return end
    if input.UserInputState ~= Enum.UserInputState.Begin then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local x, y = input.Position.X, input.Position.Y
    local ap = UIMainWindow.AbsolutePosition
    local as = UIMainWindow.AbsoluteSize
    if x < ap.X or x > ap.X + as.X or y < ap.Y or y > ap.Y + as.Y then return end
    if IsOverButtonOrTextbox(x, y) then return end

    local screen = workspace.CurrentCamera.ViewportSize
    local ch = Vector2.new(x, y) / screen
    offset = Vector2.new(UIMainWindow.Position.X.Scale, UIMainWindow.Position.Y.Scale) - ch
    dragref = input
end

UserInputService.InputBegan:Connect(function(input)
    StartDrag(input)
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragref then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or (input.UserInputType == Enum.UserInputType.Touch and dragref == input) then
        local screen = workspace.CurrentCamera.ViewportSize
        local ch = Vector2.new(input.Position.X, input.Position.Y) / screen
        local pos = ch + offset
        UIMainWindow.Position = UDim2.fromScale(pos.X, pos.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if dragref and dragref == input then dragref = nil end
end)

