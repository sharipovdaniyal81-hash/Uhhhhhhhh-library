-- ========== ОГРАНИЧЕНИЕ ПОЛОЖЕНИЯ В ПРЕДЕЛАХ ЭКРАНА ==========
local ClampPositionToScreen = function(pos)
    local viewport = workspace.CurrentCamera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return pos end
    local size = UIMainWindow.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return pos end
    local halfX = (size.X / 2) / viewport.X
    local halfY = (size.Y / 2) / viewport.Y
    return Vector2.new(
        math.clamp(pos.X, halfX, 1 - halfX),
        math.clamp(pos.Y, halfY, 1 - halfY)
    )
end
