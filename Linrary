        local obj, Out = grad.obj, grad.Out
        if obj.Parent then
            Out.Color = c
            obj.BackgroundColor3 = GetUIBGColor(t)
        end
    end

    if CracktroFrame.Parent and CracktroFrame.Visible then
        local spin = 40 + math.sin(t * 2) * 30
        Triforce.Rotation = (Triforce.Rotation + spin * dt) % 360
        local scale = 0.9 + math.sin(t * 3) * 0.05
        Triforce.Size = UDim2.new(0, 160 * scale, 0, 160 * scale)

        local frSize = CracktroFrame.AbsoluteSize
        local fov = 220
        local ring = CFrame.Angles(0, t * 0.2, math.sin(t * 0.5) * 0.3)
        for i, v in ipairs(particles) do
            local inst, pos, vel, zind = v[1], v[2], v[3], v[4]
            local d = pos.Magnitude
            if d > 0 then
                local r = math.atan2(pos.X / d, pos.Y / d)
                local a = math.pi * 0.375
                local out = Vector2.new(math.sin(r + a), math.cos(r + a))
                local tp = out * (40 + math.sin(t * 2 + i) * 15)
                local tv = (tp - pos) * 2
                vel = tv:Lerp(vel, math.exp(-2 * dt))
                pos += vel * dt
            end
            v[2], v[3] = pos, vel
            local sp = ring:VectorToWorldSpace(Vector3.new(zind * pos.Magnitude / 6, pos.Y, pos.X))
            local z = sp.Z
            local sc = fov / (z + fov)
            local x = sp.X * sc + frSize.X / 2
            local y = sp.Y * sc + frSize.Y / 2
            if z > 1 - fov then
                inst.Visible = true
                inst.Position = UDim2.fromOffset(x, y)
                inst.Size = UDim2.fromOffset(sc * 2.5, sc * 2.5)
            else
                inst.Visible = false
            end
        end
    end
end)

local clickConn
clickConn = CracktroFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if _totalrendertime < 0.5 then return end
        clickConn:Disconnect()
        CracktroFrame.Interactable = false

        local tween = TweenService:Create(CracktroFrame, TweenInfo.new(0.6, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -500, 0.5, 0),
        })
        tween:Play()
        UIMainWindow.Visible = true
        UIMainWindow.Size = UDim2.fromOffset(0, 0)
        TweenService:Create(UIMainWindow, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(360, 260),
        }):Play()

        tween.Completed:Connect(function()
            CracktroFrame.Visible = false
            task.delay(0.3, function()
                CracktroFrame:Destroy()
            end)
        end)
    end
end)
