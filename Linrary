local ASCII_LOOKUP = "BCDEIKOPQRSTUVYZ\\_`N^MJ"
local ASCII_DATA = ""
ASCII_DATA ..= "DDDDD@DFF@@@@@FSFSFSF@@@@@@@@@@@@@@EMMUKKTDD@@@@@DEEEEEDDBBBBBD@@@@@@@@@@@@@@@@@@@DE@@@G@@@@@@@@@DABBDEEI"
