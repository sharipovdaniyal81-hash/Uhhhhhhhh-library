function Uhhhhhhhh:CreateTab(name)
    local self = self
    local tab = { Elements = {} }

    -- Кнопка вкладки
    local btn = New("TextButton", {
        Size                = UDim2.new(0, 90, 0, 25),
        Position            = UDim2.new(0, 0, 0, 0),
        BackgroundColor3    = Color3.new(0, 0, 0),
        BorderSizePixel     = 0,
        Font                = Enum.Font.Code,
        TextSize            = 14,
        TextColor3          = Color3.new(1, 1, 1),
        Text                = name,
        Parent              = self.Window,
        ZIndex              = 2,
    })
    Stylize(btn)

    -- Страница (ScrollingFrame)
    local page = New("ScrollingFrame", {
        Name                = "Page_" .. name,
        Position            = UDim2.new(0, 5, 0, 40),
        Size                = UDim2.new(1, -10, 1, -45),
        BackgroundTransparency = 1,
        BorderSizePixel     = 0,
        CanvasSize          = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness  = 3,
        ScrollBarImageColor3 = Color3.new(1, 1, 1),
        ScrollingDirection  = Enum.ScrollingDirection.Y,
        Visible             = false,
        Parent              = self.Content,
    })
    New("UIListLayout", {
        Padding        = UDim.new(0, 6),
        SortOrder      = Enum.SortOrder.LayoutOrder,
        Parent         = page,
    })
    New("UIPadding", {
        PaddingTop     = UDim.new(0, 6),
        PaddingBottom  = UDim.new(0, 6),
        PaddingLeft    = UDim.new(0, 6),
        PaddingRight   = UDim.new(0, 6),
        Parent         = page,
    })

    tab.Button = btn
    tab.Page   = page

    -- Позиционирование кнопок-табов
    self._tabCount = (self._tabCount or 0) + 1
    btn.Position = UDim2.new(0, (self._tabCount - 1) * 95 + 5, 0, 32)

    btn.MouseButton1Click:Connect(function()
        PlayClick(self.Window)
        for _, t in pairs(self._tabs or {}) do
            t.Button.BackgroundColor3 = Color3.new(0, 0, 0)
            t.Page.Visible = false
        end
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        page.Visible = true
    end)

    self._tabs = self._tabs or {}
    table.insert(self._tabs, tab)
    if #self._tabs == 1 then
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        page.Visible = true
    end

    --========================================================
    -- ЭЛЕМЕНТЫ TAB
    --========================================================

    local function addElement(frame)
        frame.Parent = page
        frame.LayoutOrder = #page:GetChildren()
        return frame
    end

    -- Кнопка
    function tab:CreateButton(text, callback)
        local b = New("TextButton", {
            Size                = UDim2.new(1, 0, 0, 32),
            BackgroundColor3    = Color3.new(0, 0, 0),
            BorderSizePixel     = 0,
            Font                = Enum.Font.Code,
            TextSize            = 18,
            TextColor3          = Color3.new(1, 1, 1),
            Text                = text,
            AutoButtonColor     = false,
        })
        Stylize(b)
        addElement(b)
        b.MouseEnter:Connect(function()
            Tween:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.5}):Play()
        end)
        b.MouseLeave:Connect(function()
            Tween:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
        end)
        b.MouseButton1Click:Connect(function()
            PlayClick(self.Window)
            task.spawn(callback)
        end)
        return b
    end

    -- Разделитель
    function tab:CreateSection(text)
        local holder = New("Frame", {
            Size             = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
        })
        addElement(holder)
        local lbl = New("TextLabel", {
            Size             = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Font             = Enum.Font.Code,
            TextSize         = 16,
            TextColor3       = Color3.new(0.8, 0.8, 0.8),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = "-- " .. text .. " --",
            Parent           = holder,
        })
        return holder
    end

    -- Текст-метка
    function tab:CreateLabel(text)
        local lbl = New("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Font             = Enum.Font.Code,
            TextSize         = 14,
            TextColor3       = Color3.new(1, 1, 1),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = text,
            RichText         = true,
        })
        addElement(lbl)
        return lbl
    end

    -- Тоггл
    function tab:CreateToggle(text, default, callback)
        default = default or false
        local holder = New("Frame", {
            Size             = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1,
        })
        addElement(holder)
        local btn = New("TextButton", {
            Size             = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text             = "",
            Parent           = holder,
        })
        New("TextLabel", {
            Position         = UDim2.new(0, 4, 0, 0),
            Size             = UDim2.new(1, -40, 1, 0),
            BackgroundTransparency = 1,
            Font             = Enum.Font.Code,
            TextSize         = 16,
            TextColor3       = Color3.new(1, 1, 1),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = text,
            Parent           = holder,
        })
        local box = New("Frame", {
            AnchorPoint      = Vector2.new(1, 0.5),
            Position         = UDim2.new(1, -4, 0.5, 0),
            Size             = UDim2.new(0, 24, 0, 24),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel  = 0,
            Parent           = holder,
        })
        Stylize(box)
        local dot = New("Frame", {
            AnchorPoint      = Vector2.new(0.5, 0.5),
            Position         = UDim2.new(0.5, 0, 0.5, 0),
            Size             = UDim2.new(0, 14, 0, 14),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel  = 0,
            Visible          = default,
            Parent           = box,
        })
        New("UICorner", {CornerRadius = UDim.new(0, 2), Parent = dot})

        local state = default
        btn.MouseButton1Click:Connect(function()
            PlayClick(self.Window)
            state = not state
            dot.Visible = state
            if callback then callback(state) end
        end)
        return {Set = function(v)
            state = v
            dot.Visible = v
            if callback then callback(v) end
        end}
    end

    -- Слайдер
    function tab:CreateSlider(text, min, max, default, callback)
        min, max = min or 0, max or 100
        default = default or min
        local holder = New("Frame", {
            Size             = UDim2.new(1, 0, 0, 46),
            BackgroundTransparency = 1,
        })
        addElement(holder)
        local lbl = New("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Font             = Enum.Font.Code,
            TextSize         = 16,
            TextColor3       = Color3.new(1, 1, 1),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = text .. ": " .. default,
            Parent           = holder,
        })
        local bar = New("Frame", {
            Position         = UDim2.new(0, 0, 0, 28),
            Size             = UDim2.new(1, 0, 0, 6),
            BackgroundColor3 = Color3.new(0.3, 0.3, 0.3),
            BorderSizePixel  = 0,
            Parent           = holder,
        })
        New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = bar})
        local fill = New("Frame", {
            Size             = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel  = 0,
            Parent           = bar,
        })
        New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = fill})
        local knob = New("Frame", {
            AnchorPoint      = Vector2.new(0.5, 0.5),
            Position         = UDim2.new(0, 0, 0.5, 0),
            Size             = UDim2.new(0, 14, 0, 14),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel  = 0,
            Parent           = bar,
        })
        New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = knob})

        local value = default
        local function update()
            local p = (value - min) / (max - min)
            fill.Size = UDim2.new(p, 0, 1, 0)
            knob.Position = UDim2.new(p, 0, 0.5, 0)
            lbl.Text = text .. ": " .. Round(value, 2)
        end
        update()

        local dragging = false
        local function setFromX(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            value = min + rel * (max - min)
            update()
            if callback then callback(value) end
        end
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                setFromX(input.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        return {Set = function(v)
            value = math.clamp(v, min, max)
            update()
            if callback then callback(value) end
        end}
    end

    -- Текстовое поле
    function tab:CreateTextbox(text, placeholder, callback)
        local holder = New("Frame", {
            Size             = UDim2.new(1, 0, 0, 34),
            BackgroundTransparency = 1,
        })
        addElement(holder)
        New("TextLabel", {
            Size             = UDim2.new(0.4, 0, 1, 0),
            BackgroundTransparency = 1,
            Font             = Enum.Font.Code,
            TextSize         = 16,
            TextColor3       = Color3.new(1, 1, 1),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = text,
            Parent           = holder,
        })
        local box = New("TextBox", {
            AnchorPoint      = Vector2.new(1, 0.5),
            Position         = UDim2.new(1, 0, 0.5, 0),
            Size             = UDim2.new(0.6, 0, 1, -4),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel  = 0,
            Font             = Enum.Font.Code,
            TextSize         = 14,
            TextColor3       = Color3.new(1, 1, 1),
            PlaceholderText  = placeholder or "",
            PlaceholderColor3 = Color3.new(0.6, 0.6, 0.6),
            Text             = "",
            ClearTextOnFocus = false,
            Parent           = holder,
        })
        Stylize(box)
        box.FocusLost:Connect(function()
            if callback then callback(box.Text) end
        end)
        return box
    end

    -- Дропдаун
    function tab:CreateDropdown(text, options, default, callback)
        default = default or 1
        local holder = New("Frame", {
            Size             = UDim2.new(1, 0, 0, 34),
            BackgroundTransparency = 1,
        })
        addElement(holder)
        New("TextLabel", {
            Size             = UDim2.new(0.4, 0, 1, 0),
            BackgroundTransparency = 1,
            Font             = Enum.Font.Code,
            TextSize         = 16,
            TextColor3       = Color3.new(1, 1, 1),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = text,
            Parent           = holder,
        })
        local btn = New("TextButton", {
            AnchorPoint      = Vector2.new(1, 0.5),
            Position         = UDim2.new(1, 0, 0.5, 0),
            Size             = UDim2.new(0.6, 0, 1, -4),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel  = 0,
            Font             = Enum.Font.Code,
            TextSize         = 14,
            TextColor3       = Color3.new(1, 1, 1),
            Text             = tostring(options[default] or ""),
            Parent           = holder,
        })
        Stylize(btn)

        local list = New("ScrollingFrame", {
            AnchorPoint      = Vector2.new(0, 0),
            Position         = UDim2.new(0, 0, 0, 0),
            Size             = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel  = 0,
            CanvasSize       = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 2,
            Visible          = false,
            ZIndex           = 5,
            Parent           = self.Content,
        })
        Stylize(list)
        New("UIListLayout", {Parent = list, SortOrder = Enum.SortOrder.LayoutOrder})

        local open = false
        local current = default

        local function buildList()
            for _, c in ipairs(list:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            for i, opt in ipairs(options) do
                local o = New("TextButton", {
                    Size             = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = Color3.new(0, 0, 0),
                    BorderSizePixel  = 0,
                    Font             = Enum.Font.Code,
                    TextSize         = 14,
                    TextColor3       = Color3.new(1, 1, 1),
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    Text             = "  " .. tostring(opt),
                    LayoutOrder      = i,
                    Parent           = list,
                })
                if i == current then
                    o.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                end
                o.MouseButton1Click:Connect(function()
                    PlayClick(self.Window)
                    current = i
                    btn.Text = tostring(opt)
                    open = false
                    list.Visible = false
                    buildList()
                    if callback then callback(opt, i) end
                end)
            end
        end
        buildList()

        btn.MouseButton1Click:Connect(function()
            PlayClick(self.Window)
            open = not open
            if open then
                local p = btn.AbsolutePosition
                list.Position = UDim2.fromOffset(p.X, p.Y + btn.AbsoluteSize.Y + 2)
                list.Size = UDim2.fromOffset(btn.AbsoluteSize.X, math.min(#options * 22, 120))
            end
            list.Visible = open
        end)

        UIS.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if open then
                    local pos = input.Position
                    local ap = list.AbsolutePosition
                    local as = list.AbsoluteSize
                    if not (pos.X >= ap.X and pos.X <= ap.X + as.X
                        and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y) then
                        open = false
                        list.Visible = false
                    end
                end
            end
        end)

        return {Set = function(i)
            if options[i] then
                current = i
                btn.Text = tostring(options[i])
                buildList()
                if callback then callback(options[i], i) end
            end
        end}
    end

    return tab
end

return Uhhhhhhhh
