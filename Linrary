local UIS       = game:GetService("UserInputService")
local Tween     = game:GetService("TweenService")
local Run       = game:GetService("RunService")
local Players   = game:GetService("Players")
local Debris    = game:GetService("Debris")
local LocalPlr  = Players.LocalPlayer
local PlayerGui = LocalPlr:WaitForChild("PlayerGui")

--============================================================
-- УТИЛИТЫ
--============================================================
local function New(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function RGB(t)
    return Color3.fromHSV((t * 0.25) % 1, 0.75, 1)
end

local Strokes = {}

local function RegisterStroke(stroke)
    table.insert(Strokes, stroke)
end

--============================================================
-- ПЕРЕЛИВАНИЕ ОБВОДОК
--============================================================
local Time0 = 0
Run.RenderStepped:Connect(function(dt)
    Time0 += dt
    local c = RGB(Time0)
    for i = #Strokes, 1, -1 do
        local s = Strokes[i]
        if s and s.Parent then
            s.Color = c
        else
            table.remove(Strokes, i)
        end
    end
end)

--============================================================
-- СТИЛИЗАЦИЯ
--============================================================
local function Stylize(obj)
    New("UICorner", {CornerRadius = UDim.new(0, 5), Parent = obj})
    local stroke = New("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color           = Color3.new(1, 1, 1),
        LineJoinMode    = Enum.LineJoinMode.Round,
        Thickness       = 1,
        Parent          = obj,
    })
    obj.BackgroundColor3 = Color3.new(0, 0, 0)
    obj.BorderSizePixel  = 0
    RegisterStroke(stroke)
    return stroke
end

local function PlayClick(parent)
    local s = New("Sound", {
        SoundId = "rbxassetid://118806752369227",
        Volume  = 0.6,
        Parent  = parent or PlayerGui,
    })
    s:Play()
    Debris:AddItem(s, 3)
end

--============================================================
-- ЯДРО
--============================================================
local Uhhhhhhhh = {}
Uhhhhhhhh.__index = Uhhhhhhhh

function Uhhhhhhhh.new(config)
    config = config or {}
    local self = setmetatable({}, Uhhhhhhhh)

    local gui = New("ScreenGui", {
        Name           = "UhhhhhhhhLibrary",
        ResetOnSpawn   = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent         = PlayerGui,
    })
    self.Gui = gui

    local window = New("Frame", {
        Name                   = "Window",
        AnchorPoint            = Vector2.new(0.5, 0.5),
        Position               = UDim2.new(0.5, 0, 0.5, 0),
        Size                   = UDim2.new(0, 440, 0, 320),
        BackgroundColor3       = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.05,
        BorderSizePixel        = 0,
        Active                 = true,
        Parent                 = gui,
    })
    self.Window = window
    Stylize(window)

    local topbar = New("Frame", {
        Name                   = "TopBar",
        Size                   = UDim2.new(1, 0, 0, 32),
        BackgroundColor3       = Color3.new(0, 0, 0),
        BackgroundTransparency = 0,
        BorderSizePixel        = 0,
        ClipsDescendants       = true,
        Parent                 = window,
    })
    Stylize(topbar)

    New("TextLabel", {
        Name                   = "Title",
        Position               = UDim2.new(0, 12, 0, 0),
        Size                   = UDim2.new(1, -50, 1, 0),
        BackgroundTransparency = 1,
        Font                   = Enum.Font.Code,
        TextSize               = 20,
        TextColor3             = Color3.new(1, 1, 1),
        TextXAlignment         = Enum.TextXAlignment.Left,
        Text                   = config.Title or "Uhhhhhhhh Library",
        Parent                 = topbar,
    })

    local closeBtn = New("TextButton", {
        Name                   = "Close",
        AnchorPoint            = Vector2.new(1, 0),
        Position               = UDim2.new(1, 0, 0, 0),
        Size                   = UDim2.new(0, 32, 1, 0),
        BackgroundTransparency = 1,
        Text                   = "",
        Parent                 = topbar,
    })
    New("Frame", {
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new(0.5, 0, 0.5, 0),
        Size             = UDim2.new(0, 16, 0, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel  = 0,
        Rotation         = 45,
        Parent           = closeBtn,
    })
    New("Frame", {
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new(0.5, 0, 0.5, 0),
        Size             = UDim2.new(0, 16, 0, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel  = 0,
        Rotation         = -45,
        Parent           = closeBtn,
    })
    closeBtn.MouseButton1Click:Connect(function()
        PlayClick(window)
        gui.Enabled = false
    end)

    local content = New("Frame", {
        Name                   = "Content",
        Position               = UDim2.new(0, 0, 0, 32),
        Size                   = UDim2.new(1, 0, 1, -32),
        BackgroundTransparency = 1,
        ClipsDescendants       = true,
        Parent                 = window,
    })
    self.Content = content

    -- Перетаскивание
    do
        local dragging, dragStart, startPos
        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging  = true
                dragStart = input.Position
                startPos  = window.Position
            end
        end)
        topbar.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - dragStart
                window.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    -- Скрыть/показать по клавише
    local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == toggleKey then
            gui.Enabled = not gui.Enabled
        end
    end)

    -- Страница
    local page = New("ScrollingFrame", {
        Name                   = "Page",
        Position               = UDim2.new(0, 6, 0, 6),
        Size                   = UDim2.new(1, -12, 1, -12),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        CanvasSize             = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        ScrollBarThickness     = 3,
        ScrollBarImageColor3   = Color3.new(1, 1, 1),
        ScrollingDirection     = Enum.ScrollingDirection.Y,
        Parent                 = content,
    })
    New("UIListLayout", {
        Padding   = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent    = page,
    })
    New("UIPadding", {
        PaddingTop    = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
        PaddingLeft   = UDim.new(0, 4),
        PaddingRight  = UDim.new(0, 4),
        Parent        = page,
    })
    self.Page = page

    return self
end

--============================================================
-- ЭЛЕМЕНТЫ
--============================================================
function Uhhhhhhhh:CreateSection(text)
    local holder = New("Frame", {
        Size                   = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        LayoutOrder            = #self.Page:GetChildren(),
        Parent                 = self.Page,
    })
    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font                   = Enum.Font.Code,
        TextSize               = 16,
        TextColor3             = Color3.new(1, 1, 1),
        TextXAlignment         = Enum.TextXAlignment.Left,
        Text                   = "-- " .. text .. " --",
        Parent                 = holder,
    })
    return holder
end

function Uhhhhhhhh:CreateButton(text, callback)
    local b = New("TextButton", {
        Size             = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel  = 0,
        Font             = Enum.Font.Code,
        TextSize         = 18,
        TextColor3       = Color3.new(1, 1, 1),
        Text             = text,
        AutoButtonColor  = false,
        LayoutOrder      = #self.Page:GetChildren(),
        Parent           = self.Page,
    })
    Stylize(b)
    b.MouseEnter:Connect(function()
        Tween:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.5}):Play()
    end)
    b.MouseLeave:Connect(function()
        Tween:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
    end)
    b.MouseButton1Click:Connect(function()
        PlayClick(self.Window)
        task.spawn(callback)
    end)
    return b
end

