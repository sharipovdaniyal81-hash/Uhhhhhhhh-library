        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    }, searchBox)
    searchInput.Focused:Connect(function() tween(searchStroke, 0.15, {Color = Theme.Accent}) end)
    searchInput.FocusLost:Connect(function() tween(searchStroke, 0.15, {Color = Theme.Stroke}) end)

    --===== Tabs scroll =====
    local tabScroll = new("ScrollingFrame", {
        Position = UDim2.new(0, 0, 0, 52),
        Size = UDim2.new(1, 0, 1, -52),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.5,
    }, sidebar)
    listLayout(tabScroll, Enum.FillDirection.Vertical, 4)
    tabScroll.UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    padding(tabScroll, 6, 12, 0, 0)

    --===== Content =====
    local contentHolder = new("Frame", {
        Position = UDim2.new(0, 160, 0, 44),
        Size = UDim2.new(1, -160, 1, -44),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, panel)
    self.ContentHolder = contentHolder

    --===== Floating "B" launcher =====
    local launcher = new("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = saved.bPos and UDim2.fromOffset(saved.bPos[1], saved.bPos[2])
            or UDim2.new(0, 60, 0.5, 0),
        Size = UDim2.fromOffset(58, 58),
        BackgroundColor3 = Theme.TitleBar,
        BorderSizePixel = 0,
        Text = "B",
        Font = Enum.Font.GothamBlack,
        TextColor3 = Theme.Accent,
        TextSize = 28,
        AutoButtonColor = false,
        Visible = false,
    }, sg)
    corner(launcher, 29)
    local launcherStroke = stroke(launcher, Theme.Accent, 1.5)
    launcherStroke.Transparency = 0.2
    self.Launcher = launcher

    -- B's glow layers
    local bGlowRings = {}
    for i = 1, 3 do
        local ring = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, 6 + i * 7, 1, 6 + i * 7),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.82 + i * 0.05,
            BorderSizePixel = 0,
            ZIndex = -i,
        }, launcher)
        corner(ring, 32 + i * 7)
        local grad = new("UIGradient", {
            Rotation = 45,
            Color = ColorSequence.new(Theme.AccentDeep, Theme.Accent),
        }, ring)
        table.insert(bGlowRings, {frame = ring, gradient = grad,
            baseTransparency = 0.82 + i * 0.05})
    end

    --===== Animated purple gradient (heartbeat) =====
    local hueT = 0
    self._hueConn = RunService.Heartbeat:Connect(function(dt)
        hueT = (hueT + dt * 0.08) % 1

        local function purple(at)
            -- purple range around 0.72 - 0.86
            local h1 = (0.72 + hueT * 0.14) % 1
            local h2 = (h1 + at) % 1
            return ColorSequence.new(
                Color3.fromHSV(h1, 0.78, 1),
                Color3.fromHSV(h2, 0.72, 1),
                Color3.fromHSV((h1 + at * 2) % 1, 0.8, 1)
            )
        end

        for i, r in ipairs(glowRings) do
            if r.frame.Parent then
                r.gradient.Color = purple(0.06 * i)
                r.gradient.Rotation = (hueT * 60 + i * 45) % 360
            end
        end
        for i, r in ipairs(bGlowRings) do
            if r.frame.Parent then
                r.gradient.Color = purple(0.06 * i)
                r.gradient.Rotation = (-hueT * 90 + i * 60) % 360
            end
        end
    end)

    --===== Dragging panel =====
    do
        local dragging, dragStart, startPos = false, nil, nil
        local function begin(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging, dragStart, startPos = true, i.Position, glowContainer.Position
        end
        local function update(i)
            if not dragging then return end
            local d = i.Position - dragStart
            local vp = workspace.CurrentCamera.ViewportSize
            local sz = panel.AbsoluteSize
            local nx = startPos.X.Offset + d.X
            local ny = startPos.Y.Offset + d.Y
            nx = math.clamp(nx, -sz.X/2 + 60, vp.X - sz.X/2 - 60)
            ny = math.clamp(ny, -sz.Y/2 + 60, vp.Y - sz.Y/2 - 60)
            glowContainer.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
        end
        local function stop()
            if not dragging then return end
            dragging = false
            Config.save(self._configName, {
                pos = {glowContainer.AbsolutePosition.X + glowContainer.AbsoluteSize.X/2,
                       glowContainer.AbsolutePosition.Y + glowContainer.AbsoluteSize.Y/2},
                size = {panel.AbsoluteSize.X, panel.AbsoluteSize.Y},
                bPos = {launcher.AbsolutePosition.X + launcher.AbsoluteSize.X/2,
                        launcher.AbsolutePosition.Y + launcher.AbsoluteSize.Y/2},
            })
        end
        titleBar.InputBegan:Connect(begin)
        UserInputService.InputChanged:Connect(update)
        UserInputService.InputEnded:Connect(stop)
    end

    --===== Resize grip =====
    do
        local grip = new("TextButton", {
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -4, 1, -4),
            Size = UDim2.fromOffset(18, 18),
            BackgroundTransparency = 1,
            Text = "",
        }, panel)
        for i = 1, 3 do
            new("Frame", {
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, -3 - (i-1)*5, 1, -3 - (i-1)*5),
                Size = UDim2.fromOffset(2, 2),
                BackgroundColor3 = Theme.TextMuted,
                BorderSizePixel = 0,
            }, grip)
        end
        local resizing, rStart, rSize = false, nil, nil
        grip.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            resizing, rStart = true, i.Position
            rSize = Vector2.new(glowContainer.AbsoluteSize.X, glowContainer.AbsoluteSize.Y)
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not resizing then return end
            local d = i.Position - rStart
            glowContainer.Size = UDim2.fromOffset(
                math.max(420, rSize.X + d.X),
                math.max(260, rSize.Y + d.Y))
        end)
        UserInputService.InputEnded:Connect(function()
            if not resizing then return end
            resizing = false
            Config.save(self._configName, {
                pos = {glowContainer.AbsolutePosition.X + glowContainer.AbsoluteSize.X/2,
                       glowContainer.AbsolutePosition.Y + glowContainer.AbsoluteSize.Y/2},
                size = {panel.AbsoluteSize.X, panel.AbsoluteSize.Y},
                bPos = {launcher.AbsolutePosition.X + launcher.AbsoluteSize.X/2,
                        launcher.AbsolutePosition.Y + launcher.AbsoluteSize.Y/2},
            })
        end)
    end

    --===== Open / Close =====
    local function viewportCenterOf(inst)
        local pos = inst.AbsolutePosition + inst.AbsoluteSize / 2
        local vp = workspace.CurrentCamera.ViewportSize
        return UDim2.fromScale(pos.X / vp.X, pos.Y / vp.Y), pos
    end

    local function openPanel()
        if self._isOpen then return end
        self._isOpen = true

        -- Set container to launcher position first
        local bScale = viewportCenterOf(launcher)
        glowContainer.Position = bScale
        glowContainer.Size = UDim2.fromOffset(58, 58)

        -- Fade launcher out
        for _, r in ipairs(bGlowRings) do
            tween(r.frame, 0.25, {BackgroundTransparency = 1})
        end
        tween(launcher, 0.25, {BackgroundTransparency = 1, TextTransparency = 1})
        tween(launcherStroke, 0.25, {Transparency = 1})
        task.delay(0.25, function()
            launcher.Visible = false
            launcher.BackgroundTransparency = 0
            launcher.TextTransparency = 0
            for _, r in ipairs(bGlowRings) do
                r.frame.BackgroundTransparency = r.baseTransparency
            end
            launcherStroke.Transparency = 0.2
        end)

        -- Blur in
        Blur:SetTarget(22)

        -- Glow rings fade in (start invisible)
        for _, r in ipairs(glowRings) do
            r.frame.BackgroundTransparency = 1
            tween(r.frame, 0.6, {BackgroundTransparency = r.baseTransparency})
        end

        -- Panel grows
        local targetW = lastSize.X
        local targetH = lastSize.Y
        tween(glowContainer, 0.65, {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.fromOffset(targetW, targetH),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    local function closePanel()
        if not self._isOpen then return end
        self._isOpen = false

        -- Blur out
        Blur:SetTarget(0)

        -- Glow rings fade
        for _, r in ipairs(glowRings) do
            tween(r.frame, 0.35, {BackgroundTransparency = 1})
        end

        -- Set launcher to appear at container's current position
        local center, _ = viewportCenterOf(glowContainer)
        launcher.Position = center
        launcher.Visible = true
        launcher.BackgroundTransparency = 1
        launcher.TextTransparency = 1

        -- Shrink container to launcher size and move to launcher pos
        tween(glowContainer, 0.55, {
            Position = center,
            Size = UDim2.fromOffset(58, 58),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.In)

        -- Fade launcher in as container shrinks
        task.delay(0.35, function()
            tween(launcher, 0.3, {BackgroundTransparency = 0, TextTransparency = 0})
            for _, r in ipairs(bGlowRings) do
                tween(r.frame, 0.3, {BackgroundTransparency = r.baseTransparency})
            end
            tween(launcherStroke, 0.3, {Transparency = 0.2})
        end)

        Config.save(self._configName, {
            pos = {center.X.Scale * workspace.CurrentCamera.ViewportSize.X,
                   center.Y.Scale * workspace.CurrentCamera.ViewportSize.Y},
            size = {lastSize.X, lastSize.Y},
            bPos = {launcher.AbsolutePosition.X + launcher.AbsoluteSize.X/2,
                    launcher.AbsolutePosition.Y + launcher.AbsoluteSize.Y/2},
        })
    end

    self.Open = openPanel
    self.Close = closePanel

    closeBtn.MouseButton1Click:Connect(closePanel)

    -- Minimize
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            tween(glowContainer, 0.4, {
                Size = UDim2.fromOffset(glowContainer.AbsoluteSize.X, 44)
            }, Enum.EasingStyle.Exponential)
        else
            tween(glowContainer, 0.4, {
                Size = UDim2.fromOffset(lastSize.X, lastSize.Y)
            }, Enum.EasingStyle.Exponential)
        end
    end)

    --===== Launcher drag + click =====
    do
        local dragging, dragStart, startPos, moved = false, nil, nil, false
        launcher.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging, moved = true, false
            dragStart = i.Position
            startPos = launcher.Position
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not dragging then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            local d = i.Position - dragStart
            if math.abs(d.X) + math.abs(d.Y) > 4 then moved = true end
            if moved then
                local vp = workspace.CurrentCamera.ViewportSize
                local sz = launcher.AbsoluteSize
                local nx = startPos.X.Offset + d.X
                local ny = startPos.Y.Offset + d.Y
                nx = math.clamp(nx, sz.X/2 + 6, vp.X - sz.X/2 - 6)
                ny = math.clamp(ny, sz.Y/2 + 6, vp.Y - sz.Y/2 - 6)
                launcher.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if not dragging then return end
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging = false
            if moved then
                Config.save(self._configName, {
                    pos = {glowContainer.AbsolutePosition.X + glowContainer.AbsoluteSize.X/2,
                           glowContainer.AbsolutePosition.Y + glowContainer.AbsoluteSize.Y/2},
                    size = {lastSize.X, lastSize.Y},
                    bPos = {launcher.AbsolutePosition.X + launcher.AbsoluteSize.X/2,
                            launcher.AbsolutePosition.Y + launcher.AbsoluteSize.Y/2},
                })
            else
                openPanel()
            end
        end)
        launcher.MouseEnter:Connect(function()
            tween(launcher, 0.2, {TextColor3 = Color3.fromRGB(200, 170, 255)})
            tween(launcherStroke, 0.2, {Transparency = 0})
        end)
        launcher.MouseLeave:Connect(function()
            tween(launcher, 0.2, {TextColor3 = Theme.Accent})
            tween(launcherStroke, 0.2, {Transparency = 0.2})
        end)
    end

