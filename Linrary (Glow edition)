        Size = UDim2.new(1, -36, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = "",
        PlaceholderText = "Search...",
        PlaceholderColor3 = Theme.TextMute,
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = 5,
    }, searchBox)
    searchInput.Focused:Connect(function()
        tween(searchStroke, 0.15, {Color = Theme.Accent, Transparency = 0})
    end)
    searchInput.FocusLost:Connect(function()
        tween(searchStroke, 0.15, {Color = Theme.Stroke, Transparency = 0})
    end)

    -- Tab scroll
    local tabScroll = new("ScrollingFrame", {
        Position = UDim2.new(0, 0, 0, 52),
        Size = UDim2.new(1, 0, 1, -52),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.5,
        ZIndex = 3,
    }, sidebar)
    list(tabScroll, Enum.FillDirection.Vertical, 4,
        Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
    padding(tabScroll, 6, 12, 0, 0)

    -- Content
    local contentHolder = new("Frame", {
        Position = UDim2.new(0, 160, 0, 44),
        Size = UDim2.new(1, -160, 1, -44),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 3,
    }, panel)
    self.ContentHolder = contentHolder

    --============== Launcher B ==============
    local bcx, bcy = 60, vp.Y * 0.5
    if saved.bPos and type(saved.bPos) == "table"
        and tonumber(saved.bPos[1]) and tonumber(saved.bPos[2]) then
        bcx, bcy = saved.bPos[1], saved.bPos[2]
    end

    local launcher = new("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(bcx, bcy),
        Size = UDim2.fromOffset(58, 58),
        BackgroundColor3 = Theme.Title,
        BorderSizePixel = 0,
        Text = "B",
        Font = Enum.Font.GothamBlack,
        TextColor3 = Theme.Accent,
        TextSize = 28,
        AutoButtonColor = false,
        Visible = false,
        ZIndex = 2,
    }, sg)
    corner(launcher, 29)
    self.Launcher = launcher
    self.launcherStroke = stroke(launcher, Theme.Accent, 1.5, 0.2)

    self.bRings = {}
    for i = 1, 3 do
        local ring = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, 6 + i * 7, 1, 6 + i * 7),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.82 + i * 0.05,
            BorderSizePixel = 0,
            ZIndex = -i,
        }, launcher)
        corner(ring, 32 + i * 7)
        local grad = new("UIGradient", {
            Rotation = 45,
            Color = ColorSequence.new(Theme.AccentDim, Theme.Accent),
        }, ring)
        table.insert(self.bRings, {
            instance = ring, gradient = grad,
            baseTrans = 0.82 + i * 0.05,
        })
    end

    --============== Animated purple gradient ==============
    local hueT = 0
    self._hueConn = RunService.Heartbeat:Connect(function(dt)
        hueT = (hueT + dt * 0.09) % 1
        local function purpleSeq(spread)
            local h1 = (0.72 + hueT * 0.14) % 1
            local h2 = (h1 + spread) % 1
            local h3 = (h1 + spread * 2) % 1
            return ColorSequence.new(
                Color3.fromHSV(h1, 0.78, 1),
                Color3.fromHSV(h2, 0.72, 1),
                Color3.fromHSV(h3, 0.82, 1))
        end
        for i, r in ipairs(self.rings) do
            if r.instance.Parent then
                r.gradient.Color = purpleSeq(0.06 * i)
                r.gradient.Rotation = (hueT * 70 + i * 45) % 360
            end
        end
        for i, r in ipairs(self.bRings) do
            if r.instance.Parent then
                r.gradient.Color = purpleSeq(0.06 * i)
                r.gradient.Rotation = (-hueT * 100 + i * 60) % 360
            end
        end
    end)

    --============== Panel drag ==============
    do
        local dragging, dragStart, startPos = false, nil, nil
        titleBar.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging, dragStart, startPos = true, i.Position, container.Position
        end)
        UIS.InputChanged:Connect(function(i)
            if not dragging then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            local d = i.Position - dragStart
            local sz = container.AbsoluteSize
            local nx = startPos.X.Offset + d.X
            local ny = startPos.Y.Offset + d.Y
            nx = math.clamp(nx, sz.X/2 + 10, vp.X - sz.X/2 - 10)
            ny = math.clamp(ny, sz.Y/2 + 10, vp.Y - sz.Y/2 - 10)
            container.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
        end)
        UIS.InputEnded:Connect(function(i)
            if not dragging then return end
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging = false
            self:_save()
        end)
    end

    --============== Resize grip ==============
    do
        local grip = new("TextButton", {
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -4, 1, -4),
            Size = UDim2.fromOffset(18, 18),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 6,
        }, panel)
        for i = 1, 3 do
            new("Frame", {
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, -3 - (i-1)*5, 1, -3 - (i-1)*5),
                Size = UDim2.fromOffset(2, 2),
                BackgroundColor3 = Theme.TextMute,
                BorderSizePixel = 0,
                ZIndex = 6,
            }, grip)
        end
        local resizing, rStart, rSize = false, nil, nil
        grip.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                and i.UserInputType ~= Enum.UserInputType.Touch then return end
            resizing, rStart = true, i.Position
            rSize = Vector2.new(container.AbsoluteSize.X, container.AbsoluteSize.Y)
        end)
        UIS.InputChanged:Connect(function(i)
            if not resizing then return end
            local d = i.Position - rStart
            local nw = math.clamp(rSize.X + d.X, 380, vp.X - 20)
            local nh = math.clamp(rSize.Y + d.Y, 240, vp.Y - 20)
            container.Size = UDim2.fromOffset(nw, nh)
            self.panelW, self.panelH = nw, nh
        end)
        UIS.InputEnded:Connect(function()
            if not resizing then return end
            resizing = false
            self:_save()
        end)
    end

    --============== Open / Close ==============
    function self:_save()
        local cx = container.AbsolutePosition.X + container.AbsoluteSize.X / 2
        local cy = container.AbsolutePosition.Y + container.AbsoluteSize.Y / 2
        Config.save(self._configName, {
            pos  = {cx, cy},
            size = {self.panelW, self.panelH},
            bPos = {launcher.AbsolutePosition.X + launcher.AbsoluteSize.X / 2,
                    launcher.AbsolutePosition.Y + launcher.AbsoluteSize.Y / 2},
        })
    end

    function self:OpenPanel()
        if self._isOpen or self._animating then return end
        self._isOpen = true
        self._animating = true

        local bCenter = launcher.AbsolutePosition + launcher.AbsoluteSize * 0.5
        container.Position = UDim2.fromOffset(bCenter.X, bCenter.Y)
        container.Size = UDim2.fromOffset(58, 58)
        container.Visible = true

        -- Fade launcher out
        tween(launcher, 0.2, {BackgroundTransparency = 1, TextTransparency = 1})
        tween(self.launcherStroke, 0.2, {Transparency = 1})
        for _, r in ipairs(self.bRings) do
            tween(r.instance, 0.2, {BackgroundTransparency = 1})
        end

        -- Blur in
        Blur.target = 22

        -- Rings fade in
        for _, r in ipairs(self.rings) do
            r.instance.BackgroundTransparency = 1
        end
        for _, r in ipairs(self.rings) do
            tween(r.instance, 0.6, {BackgroundTransparency = r.baseTrans},
                Enum.EasingStyle.Quint)
        end

        -- Compute target
        local saved = Config.load(self._configName)
        local vp2 = workspace.CurrentCamera.ViewportSize
        local tcx, tcy = vp2.X * 0.5, vp2.Y * 0.5
        if saved.pos and tonumber(saved.pos[1]) and tonumber(saved.pos[2]) then
            tcx, tcy = saved.pos[1], saved.pos[2]
        end
        local tw, th = self.panelW, self.panelH
        if saved.size and tonumber(saved.size[1]) and tonumber(saved.size[2]) then
            tw = math.clamp(saved.size[1], 340, vp2.X - 40)
            th = math.clamp(saved.size[2], 260, vp2.Y - 40)
            self.panelW, self.panelH = tw, th
        end

        local growTw = tween(container, 0.55, {
            Position = UDim2.fromOffset(tcx, tcy),
            Size = UDim2.fromOffset(tw, th),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        -- Hide launcher after fade
        task.delay(0.22, function()
            launcher.Visible = false
            launcher.BackgroundTransparency = 0
            launcher.TextTransparency = 0
            self.launcherStroke.Transparency = 0.2
            for _, r in ipairs(self.bRings) do
                r.instance.BackgroundTransparency = r.baseTrans
            end
        end)

        growTw.Completed:Connect(function()
            self._animating = false
        end)
    end

    function self:ClosePanel()
        if not self._isOpen or self._animating then return end
        self._isOpen = false
        self._animating = true

        Blur.target = 0

        for _, r in ipairs(self.rings) do
            tween(r.instance, 0.35, {BackgroundTransparency = 1})
        end

        -- Remember where the B should appear
        local bCenter = launcher.AbsolutePosition + launcher.AbsoluteSize * 0.5

        -- Fade launcher in later (after container shrinks)
        launcher.Visible = true
        launcher.BackgroundTransparency = 1
        launcher.TextTransparency = 1
        self.launcherStroke.Transparency = 1
        for _, r in ipairs(self.bRings) do
            r.instance.BackgroundTransparency = 1
        end

        -- Shrink container toward launcher
        local shrinkTw = tween(container, 0.55, {
            Position = UDim2.fromOffset(bCenter.X, bCenter.Y),
            Size = UDim2.fromOffset(58, 58),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.In)

        task.delay(0.35, function()
            tween(launcher, 0.3, {BackgroundTransparency = 0, TextTransparency = 0})
            tween(self.launcherStroke, 0.3, {Transparency = 0.2})
            for _, r in ipairs(self.bRings) do
                tween(r.instance, 0.3, {BackgroundTransparency = r.baseTrans})
            end
        end)

        shrinkTw.Completed:Connect(function()
            container.Visible = false
            self._animating = false
            self:_save()
        end)
    end

