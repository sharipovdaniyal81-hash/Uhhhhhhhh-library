        local grad = new("UIGradient", {
            Rotation = 45,
            Color = ColorSequence.new(Theme.AccentDim, Theme.Accent),
        }, ring)
        table.insert(self.rings, {
            instance = ring, gradient = grad,
            baseTrans = baseTrans, offset = offset,
