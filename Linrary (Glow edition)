    local saved = Config.load(self._configName)

    local sg = new("ScreenGui", {
        Name = "UhhhhhhhLibrary",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 2147483647,
