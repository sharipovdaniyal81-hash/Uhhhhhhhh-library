--===== Notifications =====
function Library:Notify(opts)
    opts = opts or {}
    local kind = opts.type or "info"
    local accent = ({
        info    = Theme.Accent,
        success = Theme.Success,
        warning = Theme.Warning,
        error   = Theme.Error,
    })[kind] or Theme.Accent

    self._notifyOrder = (self._notifyOrder or 0) + 1

    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Card,
        BorderSizePixel = 0,
        LayoutOrder = -self._notifyOrder,
        ClipsDescendants = false,
        BackgroundTransparency = 0.05,
    }, self.NotifyContainer)
    corner(card, 10)

    local glow1 = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, 14, 1, 14),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.88,
        BorderSizePixel = 0,
        ZIndex = -2,
    }, card)
    corner(glow1, 14)

    local glow2 = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, 26, 1, 26),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.94,
        BorderSizePixel = 0,
        ZIndex = -3,
    }, card)
    corner(glow2, 20)

    local cardStroke = stroke(card, accent, 1.2); cardStroke.Transparency = 0.5

    local accentBar = new("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
    }, card)
    corner(accentBar, 2)

    padding(card, 12, 12, 18, 14)
    listLayout(card, Enum.FillDirection.Vertical, 3)

    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = opts.title or "Notification",
        TextColor3 = Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    if opts.content and opts.content ~= "" then
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            Text = opts.content,
            TextColor3 = Theme.TextDim,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LineHeight = 1.15,
        }, card)
    end

    card.Position = UDim2.new(0, 50, 0, 0)
    card.BackgroundTransparency = 0.05
    tween(card, 0.55, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Exponential)
    glow1.BackgroundTransparency = 1
    glow2.BackgroundTransparency = 1
    tween(glow1, 0.6, {BackgroundTransparency = 0.88})
    tween(glow2, 0.7, {BackgroundTransparency = 0.94})

    task.delay(opts.duration or 4.5, function()
        if not card.Parent then return end
        local tw = tween(card, 0.4, {
            Position = UDim2.new(0, 50, 0, 0),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quint)
        tween(cardStroke, 0.4, {Transparency = 1})
        tween(accentBar, 0.4, {BackgroundTransparency = 1})
        tween(glow1, 0.4, {BackgroundTransparency = 1})
        tween(glow2, 0.4, {BackgroundTransparency = 1})
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") then tween(d, 0.4, {TextTransparency = 1}) end
        end
        tw.Completed:Connect(function() card:Destroy() end)
    end)
end

