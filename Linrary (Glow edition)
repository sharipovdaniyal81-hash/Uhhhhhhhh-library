--=====================================================================
--  Helpers
--=====================================================================
local function new(class, props, parent)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do inst[k] = v end
    end
    inst.Parent = parent
    return inst
end

local function corner(p, r)
    return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p)
end

local function stroke(p, color, thick, trans)
    return new("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thick or 1,
        Transparency = trans or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
end

local function padding(p, t, b, l, r)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
    }, p)
end

local function list(p, dir, pad, halign, valign)
    return new("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, pad or 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
    }, p)
end

local function tween(inst, dur, props, style, dir)
    local ti = TweenInfo.new(dur or 0.2, style or Enum.EasingStyle.Quint,
        dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(inst, ti, props)
    t:Play()
    return t
end

--=====================================================================
--  Background Blur (safe)
--=====================================================================
local Blur = { cur = 0, target = 0 }

do
    local ok, found = pcall(function() return Lighting:FindFirstChildOfClass("BlurEffect") end)
    if ok and found then
        Blur.effect = found
        Blur.original = found.Size
        Blur.cur = found.Size
    else
        local ok2, created = pcall(function()
            return new("BlurEffect", {Size = 0, Name = "UhhhhhhBlur"}, Lighting)
        end)
        if ok2 then
            Blur.effect = created
            Blur.original = nil
            Blur.cur = 0
        end
    end

    RunService.RenderStepped:Connect(function(dt)
        if not Blur.effect or not Blur.effect.Parent then return end
        local d = Blur.target - Blur.cur
        if math.abs(d) > 0.05 then
            Blur.cur = Blur.cur + d * math.min(dt * 9, 1)
            Blur.effect.Size = Blur.cur
        elseif Blur.cur ~= Blur.target then
            Blur.cur = Blur.target
            Blur.effect.Size = Blur.cur
        end
    end)
end

--=====================================================================
--  Config
--=====================================================================
local Config = {}
do
    local hasFS = typeof(writefile) == "function" and typeof(readfile) == "function"
    local folder = "UhhhhhhhLibrary"

    if hasFS and typeof(isfolder) == "function" and typeof(makefolder) == "function" then
        pcall(function()
            if not isfolder(folder) then makefolder(folder) end
        end)
    end

    function Config.save(name, data)
        if not hasFS then return end
        pcall(function()
            writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
        end)
    end

    function Config.load(name)
        if not hasFS then return {} end
        local ok, data = pcall(function()
            local path = folder .. "/" .. name .. ".json"
            if typeof(isfile) == "function" and isfile(path) then
                return HttpService:JSONDecode(readfile(path))
            end
        end)
        if ok and typeof(data) == "table" then return data end
        return {}
    end
end

