--=====================================================================
--  Utilities
--=====================================================================
local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function stroke(p, c, t) return new("UIStroke", {Color = c or Theme.Stroke,
    Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p) end
local function padding(p, t, b, l, r) return new("UIPadding", {
    PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
    PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0)}, p) end
local function listLayout(p, dir, pad)
    return new("UIListLayout", {FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, pad or 6), SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top}, p) end
local function tween(inst, dur, props, style, dir)
    local t = TweenService:Create(inst, TweenInfo.new(dur or 0.2,
        style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play(); return t
end
local function fmt(n)
    if n ~= math.floor(n) then return string.format("%.2f", n) end
    return tostring(math.floor(n))
end

--=====================================================================
--  Background blur controller
--=====================================================================
local Blur = {}
do
    local existing = Lighting:FindFirstChildOfClass("BlurEffect")
    if existing then
        Blur.instance = existing
        Blur._prev = existing.Size
    else
        Blur.instance = new("BlurEffect", {Name = "UhhhhhhhBlur", Size = 0}, Lighting)
        Blur._prev = 0
    end
    Blur._current = Blur.instance.Size
    Blur._target  = Blur._current

    function Blur:SetTarget(sz) self._target = sz end
    function Blur:Shutdown()
        if self.instance and self.instance.Name == "UhhhhhhhBlur" then
            self.instance:Destroy()
        elseif self.instance then
            self.instance.Size = self._prev
        end
    end

    RunService.RenderStepped:Connect(function(dt)
        if not Blur.instance or not Blur.instance.Parent then return end
        local diff = Blur._target - Blur._current
        if math.abs(diff) < 0.05 then
            if Blur._current ~= Blur._target then
                Blur._current = Blur._target
                Blur.instance.Size = Blur._current
            end
            return
        end
        Blur._current = Blur._current + diff * math.min(dt * 8, 1)
        Blur.instance.Size = Blur._current
    end)
end

--=====================================================================
--  Config
--=====================================================================
local Config = {}
do
    local hasFS = typeof(writefile) == "function" and typeof(readfile) == "function"
    local folder = "UhhhhhhhLibrary"
    if hasFS then pcall(function()
        if typeof(isfolder) == "function" and not isfolder(folder) then makefolder(folder) end
    end) end
    function Config.save(name, data)
        if not hasFS then return end
        pcall(function()
            writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
        end)
    end
    function Config.load(name)
        if not hasFS then return {} end
        local ok, data = pcall(function()
            local path = folder .. "/" .. name .. ".json"
            if typeof(isfile) == "function" and isfile(path) then
                return HttpService:JSONDecode(readfile(path))
            end
        end)
        if ok and typeof(data) == "table" then return data end
        return {}
    end
end

