        corner(btn, 7)
        local s = stroke(btn, bg, 1, 0.5)
        btn.MouseEnter:Connect(function()
            tween(btn, 0.15, {BackgroundColor3 = bgHov})
            tween(s, 0.15, {Color = bgHov, Transparency = 0.2})
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.15, {BackgroundColor3 = bg})
            tween(s, 0.15, {Color = bg, Transparency = 0.5})
