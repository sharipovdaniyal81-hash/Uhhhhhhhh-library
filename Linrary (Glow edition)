                end)
                ob.MouseLeave:Connect(function()
                    tween(ob, 0.15, {BackgroundTransparency = 1, TextColor3 = Theme.TextDim})
                end)
                ob.MouseButton1Click:Connect(function()
                    selected = opt
                    valueLabel.Text = opt
                    open = false
                    tween(row, 0.3, {Size = UDim2.new(1, -6, 0, 42)}, Enum.EasingStyle.Exponential)
                    tween(arrow, 0.3, {Rotation = 0})
                    if o.callback then task.spawn(function() pcall(o.callback, opt) end) end
                end)
            end

            local click = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 42),
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = 6,
            }, row)
            click.MouseEnter:Connect(function() tween(s, 0.15, {Color = Theme.StrokeHov}) end)
            click.MouseLeave:Connect(function() tween(s, 0.15, {Color = Theme.Stroke}) end)
            click.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    local targetH = 42 + #options * 30 + 8
                    tween(row, 0.35, {Size = UDim2.new(1, -6, 0, targetH)},
                        Enum.EasingStyle.Exponential)
                    tween(arrow, 0.3, {Rotation = 180})
                else
                    tween(row, 0.3, {Size = UDim2.new(1, -6, 0, 42)},
                        Enum.EasingStyle.Exponential)
                    tween(arrow, 0.3, {Rotation = 0})
                end
            end)

            return {
                Set = function(_, v)
                    if table.find(options, v) then
                        selected = v; valueLabel.Text = v
                        if o.callback then task.spawn(function() pcall(o.callback, v) end) end
                    end
                end,
                Get = function() return selected end,
            }
        end

        function tab:CreateInput(o)
            o = o or {}
            local row = new("Frame", {
                Size = UDim2.new(1, -6, 0, 42),
                BackgroundColor3 = Theme.Card,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(),
                ZIndex = 3,
            }, tabContent)
            corner(row, 10)
            local s = stroke(row, Theme.Stroke, 1, 0)

            new("TextLabel", {
                Size = UDim2.new(0, 150, 1, 0),
                Position = UDim2.new(0, 16, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = o.name or "Input",
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 5,
            }, row)

            local box = new("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -16, 0.5, 0),
                Size = UDim2.new(0, 190, 0, 28),
                BackgroundColor3 = Theme.BG,
                BorderSizePixel = 0,
                ZIndex = 4,
            }, row)
            corner(box, 8)
            local boxStroke = stroke(box, Theme.Stroke, 1, 0)

            local input = new("TextBox", {
                Size = UDim2.new(1, -16, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = o.default or "",
                PlaceholderText = o.placeholder or "Type here...",
                PlaceholderColor3 = Theme.TextMute,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                ZIndex = 5,
            }, box)

            input.Focused:Connect(function()
                tween(boxStroke, 0.15, {Color = Theme.Accent})
            end)
            input.FocusLost:Connect(function(enter)
                tween(boxStroke, 0.15, {Color = Theme.Stroke})
                if o.callback then
                    task.spawn(function() pcall(o.callback, input.Text, enter) end)
                end
            end)

            return {
                Set = function(_, v) input.Text = v end,
                Get = function() return input.Text end,
            }
        end

        function tab:CreateKeybind(o)
            o = o or {}
            local key = o.default or "F"

            local row = new("Frame", {
                Size = UDim2.new(1, -6, 0, 42),
                BackgroundColor3 = Theme.Card,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(),
                ZIndex = 3,
            }, tabContent)
            corner(row, 10)
            local s = stroke(row, Theme.Stroke, 1, 0)

            new("TextLabel", {
                Size = UDim2.new(1, -100, 1, 0),
                Position = UDim2.new(0, 16, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = o.name or "Keybind",
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 5,
            }, row)

            local keyBtn = new("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -16, 0.5, 0),
                Size = UDim2.fromOffset(80, 28),
                BackgroundColor3 = Theme.BG,
                BorderSizePixel = 0,
                Text = key,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Text,
                TextSize = 12,
                AutoButtonColor = false,
                ZIndex = 4,
            }, row)
            corner(keyBtn, 8)
            local kbStroke = stroke(keyBtn, Theme.Stroke, 1, 0)

            local capturing = false
            keyBtn.MouseButton1Click:Connect(function()
                capturing = true
                keyBtn.Text = "..."
                tween(kbStroke, 0.15, {Color = Theme.Accent})
            end)

            UIS.InputBegan:Connect(function(input, gp)
                if not capturing or gp then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    key = input.KeyCode.Name
                    keyBtn.Text = key
                    capturing = false
                    tween(kbStroke, 0.15, {Color = Theme.Stroke})
                    if o.callback then task.spawn(function() pcall(o.callback, key) end) end
                end
            end)
            UIS.InputBegan:Connect(function(input, gp)
                if gp or capturing then return end
                if input.UserInputType == Enum.UserInputType.Keyboard
                    and input.KeyCode.Name == key and o.onPress then
                    task.spawn(function() pcall(o.onPress) end)
                end
            end)

            return {
                Set = function(_, v) key = v; keyBtn.Text = v end,
                Get = function() return key end,
            }
        end

        return tab
    end

    -- tab search
    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(searchInput.Text)
        for _, t in ipairs(self.Tabs) do
            local match = q == "" or string.find(string.lower(t.Name), q, 1, true)
            t.Button.Visible = match
        end
    end)

    return self
end

