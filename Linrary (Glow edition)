--=====================================================================
--  Safe gui parent
--=====================================================================
local function getGuiParent()
    if typeof(gethui) == "function" then
        local ok, r = pcall(gethui)
        if ok and r then return r end
    end
    if typeof(get_hidden_gui) == "function" then
        local ok, r = pcall(get_hidden_gui)
        if ok and r then return r end
    end
    return CoreGui
end

