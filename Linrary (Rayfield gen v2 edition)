-- Uhhhhhhh Library — Rayfield Gen2 template
-- All buttons and links migrated 1:1 from the manual GUI.

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Uhhhhhhh Library",
    subtitle = "Modded — by Uhhhhhh",
    sidebarLayout = true,
    configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "UhhhhhhhLibrary",
    },
})

-- ===== Tabs =====
local MorphsTab = Window:CreateTab({ name = "Morphs" })
local MiscTab   = Window:CreateTab({ name = "Misc" })
local InfoTab   = Window:CreateTab({ name = "Info" })

-- ===== Helper =====
local function load(url)
    pcall(function()
        loadstring(game:HttpGet(url))()
    end)
end

